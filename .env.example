# ============================================================
#  Tacos Galos · variables de entorno
#  Copia este fichero a .env.local para desarrollo.
#  Este .env.example SÍ se commitea (es la plantilla). Los que llevan valores
#  reales — .env, .env.local, .env.*.local — están en .gitignore: no los subas.
# ============================================================

# ------------------------------------------------------------
# OBLIGATORIA PARA DESPLEGAR
# ------------------------------------------------------------
# URL pública del sitio, SIN barra final.
#
# De aquí cuelgan las canónicas, los Open Graph, las tarjetas de Twitter y
# el JSON-LD Restaurant de cada local. Si falta, el build genera todas esas
# URLs apuntando a http://localhost:3000 y el aviso sale por consola.
#
# ⚠️ NO uses tacosgalos.com: ese dominio NO es de la marca, está aparcado y
# a la venta ("This domain may be for sale"). tacosgalos.es es un placeholder
# de IONOS. Hay que decidir el dominio definitivo con la marca.
NEXT_PUBLIC_SITE_URL=https://tu-dominio-de-la-demo.com


# ------------------------------------------------------------
# AÚN NO SE USAN — llegan con el MVP real
# ------------------------------------------------------------
# Supabase: catálogo, locales, pedidos y Realtime para el panel de cocina.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE=          # solo servidor, jamás en el cliente

# Stripe Checkout (hosted). Requiere hosting con servidor: el export
# estático no puede ejecutar API routes.
# STRIPE_SECRET_KEY=              # solo servidor
# STRIPE_WEBHOOK_SECRET=
